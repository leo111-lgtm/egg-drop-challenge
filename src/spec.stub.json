 "build_steps": [
  {
   "n": 1,
   "title": "Cut the canopy",
   "detail": "Cut a 27 \u00d7 27 cm square of single-wall corrugated. Cut a 3 cm hole dead centre. Tape all four edges.",
   "minutes": 12,
   "tools": "ruler, box cutter, tape",
   "tip": "Cut on a scrap board, flutes in one direction.",
   "component_ids": [
    "canopy"
   ]
  },
  {
   "n": 2,
   "title": "Cut and fold the sleeve",
   "detail": "Cut a 64.8 \u00d7 16 cm strip, score three folds, fold into a 16 \u00d7 16 cm tube and glue the tab. Cut the 8 \u00d7 10 cm door 3 cm above the bottom edge of one wall. Glue in a 16 \u00d7 16 cm floor.",
   "minutes": 20,
   "tools": "ruler, box cutter, hot glue",
   "tip": "Score, don't cut, the fold lines.",
   "component_ids": [
    "wall_front",
    "wall_back",
    "wall_left",
    "wall_right",
    "floor"
   ]
  },
  {
   "n": 3,
   "title": "Punch the anchor holes",
   "detail": "Eight holes 1.5 cm in from each vertical corner, 1.5 cm below the top and 1.5 cm above the floor. Push a band through each and slip a 3 cm straw toggle through the loop outside.",
   "minutes": 10,
   "tools": "pencil, scissors",
   "tip": "Number the toggles 1\u20138.",
   "component_ids": [
    "toggles"
   ]
  },
  {
   "n": 4,
   "title": "Make the pod",
   "detail": "Cut one egg-carton cell with its lid section, hinge kept. Glue a 1 cm sponge disc into the cell and one into the lid. Mark EGG and WIDE END DOWN.",
   "minutes": 10,
   "tools": "scissors, hot glue, marker",
   "tip": "Trace the egg outline into the sponge.",
   "component_ids": [
    "pod",
    "egg"
   ]
  },
  {
   "n": 5,
   "title": "Fit the sock",
   "detail": "Load a test egg, close the lid, band the pod across the hinge, push it into the sock toe. Mark the UP line on the sock. Make 4 holes below the cuff and 4 at the toe.",
   "minutes": 8,
   "tools": "marker, hot glue",
   "tip": "",
   "component_ids": [
    "sock"
   ]
  },
  {
   "n": 6,
   "title": "Hang the sock",
   "detail": "Loop the 4 top bands through the cuff holes and the 4 bottom bands through the toe holes so the pod floats centred with 3 cm above and below and 5 cm to each wall.",
   "minutes": 12,
   "tools": "",
   "tip": "Shorten a sagging band by looping it twice around its toggle.",
   "component_ids": [
    "bands"
   ]
  },
  {
   "n": 7,
   "title": "Add the pads",
   "detail": "Fold two 12 \u00d7 12 cm newspaper pads 1.5 cm thick. Tape one to the floor and one to the canopy underside.",
   "minutes": 6,
   "tools": "tape",
   "tip": "",
   "component_ids": [
    "pad_floor",
    "pad_top"
   ]
  },
  {
   "n": 8,
   "title": "Glue the sleeve to the canopy",
   "detail": "Hot-glue the top of the sleeve onto the canopy underside inside the 16 cm square; tape tabs over the joint. Tie a string diagonal across each wall.",
   "minutes": 10,
   "tools": "hot glue, tape, string",
   "tip": "",
   "component_ids": [
    "strings"
   ]
  },
  {
   "n": 9,
   "title": "Fit the cups",
   "detail": "Pre-crease 8 cups. Glue 4 mouth-down under the floor corners with a tape collar. Glue 4 base-down on the canopy corners.",
   "minutes": 12,
   "tools": "hot glue, tape",
   "tip": "",
   "component_ids": [
    "cups_bottom",
    "cups_top"
   ]
  },
  {
   "n": 10,
   "title": "Check the envelope and weigh",
   "detail": "27 \u00d7 27 \u00d7 27.4 cm with the ruler; about 275 g with the egg.",
   "minutes": 5,
   "tools": "ruler, kitchen scale",
   "tip": "",
   "component_ids": []
  },
  {
   "n": 11,
   "title": "Pack the spares bag",
   "detail": "8 creased cups, 8 bands, 2 pads, a spare wall panel, tape, marker, spare eggs.",
   "minutes": 5,
   "tools": "",
   "tip": "",
   "component_ids": []
  },
  {
   "n": 12,
